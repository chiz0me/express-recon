{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/chiz0me/express-recon/main/schemas/render/v1/bundle.schema.json",
  "title": "Render bundle v1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 2048
    },
    "kind": {
      "const": "render-bundle"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["name", "version"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,252}$"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        }
      },
      "required": ["host", "owner"]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": ["boolean", "null"]
        },
        "reasons": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "required": ["complete", "reasons"]
    },
    "repositories": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "repository.schema.json"
      }
    },
    "statistics": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": ["id", "label", "value", "unit"]
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*\\.[a-zA-Z0-9._-]+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "producer",
    "generatedAt",
    "organization",
    "coverage",
    "repositories"
  ]
}
