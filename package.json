{
  "name": "express-recon",
  "version": "0.9.0",
  "description": "Offline-first Express, Fastify, and NestJS route inventory, auth audit, OpenAPI reconciliation, and GitHub organization discovery.",
  "keywords": [
    "audit",
    "authentication",
    "authorization",
    "express",
    "fastify",
    "github",
    "mcp",
    "middleware",
    "nestjs",
    "offline",
    "openapi",
    "organization-inventory",
    "routes",
    "sast",
    "security",
    "static-analysis",
    "swagger"
  ],
  "homepage": "https://github.com/chiz0me/express-recon#readme",
  "bugs": {
    "url": "https://github.com/chiz0me/express-recon/issues"
  },
  "license": "MIT",
  "author": "chiz0me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiz0me/express-recon.git"
  },
  "bin": {
    "express-recon": "src/cli.js",
    "express-recon-mcp": "src/mcp/server.js"
  },
  "files": [
    "src",
    "skills",
    "LICENSE",
    "README.md",
    "src/cli.js",
    "src/mcp/server.js"
  ],
  "main": "src/index.js",
  "scripts": {
    "check": "npm run lint && npm run fmt:check && npm run docs:coverage && npm run test:coverage && npm run check:version",
    "docs:check": "npm run docs:coverage && node --test testcases/documentation.test.js",
    "docs:coverage": "node scripts/check-documentation-coverage.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=92 --test-coverage-branches=77 --test-coverage-functions=90",
    "lint": "oxlint",
    "logo:build": "node scripts/build-logo-variants.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check src testcases",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:version": "node scripts/check-version.js",
    "version": "node scripts/sync-version.js && git add .claude-plugin/plugin.json",
    "prepublishOnly": "node scripts/check-version.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "oxc-parser": "0.135.0",
    "swagger-ui-dist": "5.32.14",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scarfSettings": {
    "enabled": false
  }
}
